# Copy to .env and set your values. Docker Compose reads .env automatically.

# Required: bearer secret of /admin and /internal. Use a long random value; never commit .env.
PDMS_GATEWAY_ADMIN_TOKEN=

# Gateway owns the shared schema, including decentralized ledger tables.
# Use the database hostname/IP reachable FROM the gateway container.
PDMS_GATEWAY_FLYWAY_ENABLED=true
PDMS_GATEWAY_FLYWAY_URL=jdbc:postgresql://<db-host>:5432/pdms
PDMS_GATEWAY_FLYWAY_USER=pdms_user
PDMS_GATEWAY_FLYWAY_PASSWORD=

# Real PDMS: one in-memory flag enables business HTTP and ordinary outbox together.
PDMS_GATEWAY_RUNTIME_MANAGED=true
PDMS_GATEWAY_RUNTIME_DRAIN_TIMEOUT=30s

# Same backend outbox secret as PDMS; distinct from the gateway bearer secret. Required for managed handovers.
PDMS_OUTBOX_ADMIN_TOKEN=
#PDMS_GATEWAY_OUTBOX_TIMEOUT=10s

# Identifies the run in every log row and in the log file name.
PDMS_GATEWAY_RUN_ID=adhoc

# Published address of the Gateway. Use an experiment interface for remote workloads.
PDMS_GATEWAY_BIND=

# Routing table on the host (see config/routing.example.json). Default: ./config/routing.json
#PDMS_GATEWAY_ROUTING_FILE_HOST=./config/routing.json

# Set and record any heap or GC overrides used for the run.
#JAVA_TOOL_OPTIONS=
# Scheduled selection application also requires selector autoEvaluate=true and applyChanges=true.
PDMS_GATEWAY_SELECTION_ALLOW_APPLY=false

# Optional controlled-stimulus matched-sequence experiment; off outside experiments.
PDMS_GATEWAY_EXPERIMENT_ENABLED=false

# Profiles, thresholds, stimuli and warm-up time. The bundled file has no automatic run.
#PDMS_GATEWAY_EXPERIMENT_FILE=file:/app/experiments/selection-experiment.json
