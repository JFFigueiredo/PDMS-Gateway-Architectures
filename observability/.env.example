# Copy to .env. Keep real credentials out of source control.
PDMS_OBSERVER_GATEWAY_URL=http://pdms-gateway:8080
PDMS_GATEWAY_ADMIN_TOKEN=
PGHOST=postgres
PGPORT=5432
PGDATABASE=pdms
PGUSER=pdms_metrics_reader
PGPASSWORD=
PDMS_OBSERVER_INTERVAL_SECONDS=5
PDMS_OBSERVER_MAX_AGE_SECONDS=20
# Existing network with the gateway; database must be reachable from it.
PDMS_OBSERVER_NETWORK=pdms-gateway_default
PDMS_OBSERVER_BIND=
